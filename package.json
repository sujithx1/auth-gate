{
  "name": "authgate-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/adapters/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "bun --watch apps/auth-server/src/index.ts",
    "dev:dashboard": "bun --cwd apps/admin-dashboard dev",
    "dev": "bun run dev:server & bun run dev:dashboard",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.3.3"
  }
}

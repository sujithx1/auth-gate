# AuthGate Environment Variables Example

# The port the Hono REST API server runs on
PORT=3005

# Database connection URL (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/authgate

# Allowed origins for CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Node environment (production or development)
NODE_ENV=development

# Client API endpoint (Vite frontend)
VITE_API_URL=http://localhost:3005

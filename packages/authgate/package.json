{
  "name": "@sujithx/authgate",
  "version": "1.0.10",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "private": false,
  "description": "Official TypeScript / JavaScript SDK for AuthGate — The modern IAM platform.",
  "keywords": [
    "auth",
    "authentication",
    "authorization",
    "iam",
    "oauth",
    "oidc",
    "sso",
    "saml",
    "totp",
    "jwt",
    "rbac"
  ],
  "author": "Sujith",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sujithx1/authgate.git"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "devDependencies": {
    "@authgate/shared": "workspace:*",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  }
}
